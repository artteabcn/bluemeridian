---
import TopNav from '../components/TopNav.astro';
import { ensureSignatureRequestsTable } from '../lib/signature-requests-table';
import { getAccessEmail } from '../lib/access';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const db = Astro.locals.runtime.env.DB;

await ensureSignatureRequestsTable(db);

const { results: shareholders } = await db.prepare('SELECT * FROM shareholders ORDER BY id').all() as {
  results: Array<{ id: number; name: string; jurisdiction: string; percentage: number; email: string | null }>;
};

const { results: pendingRequests } = await db.prepare(
  "SELECT * FROM signature_requests WHERE status != 'completed' ORDER BY created_at DESC"
).all() as {
  results: Array<{ id: number; title: string; doc_type: string; signer_emails: string; created_at: string }>;
};

const accessEmail = getAccessEmail(Astro.request);
const currentShareholder = shareholders.find(sh => sh.email && accessEmail && sh.email.toLowerCase() === accessEmail.toLowerCase());

const myPendingRequests = pendingRequests.filter(r => {
  const signed = JSON.parse(r.signer_emails || '[]') as string[];
  return !currentShareholder?.email || !signed.map(e => e.toLowerCase()).includes(currentShareholder.email.toLowerCase());
});

const totalPct = shareholders.reduce((s, sh) => s + sh.percentage, 0);
const today = new Date().toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0f2537" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script src="/register-sw.js" defer></script>
  <title>Blue Meridian Fisheries — Shareholder Ledger</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #060d14;
      --surface:  #0b1928;
      --surface2: #0f2437;
      --border:   rgba(201,169,110,.14);
      --border2:  rgba(255,255,255,.06);
      --gold:     #c9a96e;
      --gold-d:   #8a6d3b;
      --gold-l:   #e8d5a3;
      --text:     #f0ede8;
      --muted:    #4a6580;
      --muted2:   #2d4560;
      --green:    #3dd68c;
      --amber:    #e0a94b;
      --red:      #f86b6b;
      --ease:     cubic-bezier(.32,.72,0,1);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      padding: 52px 28px 80px;
    }

    .wrap { max-width: 1080px; margin: 0 auto; }

    /* ── Header ─────────────────────────────────────── */
    .hdr {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 36px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 32px;
    }
    .eyebrow {
      display: inline-block;
      font-size: 9.5px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid rgba(201,169,110,.3);
      border-radius: 100px;
      padding: 3px 10px;
      margin-bottom: 14px;
      font-weight: 500;
    }
    .hdr h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 52px;
      font-weight: 600;
      letter-spacing: -.02em;
      line-height: 1;
      color: var(--text);
    }
    .hdr-sub { font-size: 12px; color: var(--muted); margin-top: 10px; letter-spacing: .02em; }
    .hdr-right { text-align: right; }
    .hdr-date { font-size: 11.5px; color: var(--muted); margin-bottom: 8px; }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10.5px;
      font-weight: 500;
      color: var(--green);
      background: rgba(61,214,140,.08);
      border: 1px solid rgba(61,214,140,.22);
      border-radius: 100px;
      padding: 4px 10px;
    }
    .dot {
      width: 5px; height: 5px;
      background: var(--green);
      border-radius: 50%;
      animation: pulse 2.4s infinite;
    }
    @keyframes pulse { 0%,100% { opacity:1 } 50% { opacity:.35 } }

    /* ── Alert banner ────────────────────────────────── */
    .alert {
      display: flex;
      align-items: center;
      gap: 14px;
      background: rgba(224,169,75,.08);
      border: 1px solid rgba(224,169,75,.32);
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 28px;
    }
    .alert svg { color: var(--amber); flex-shrink: 0; }
    .alert-title { font-size: 13.5px; font-weight: 600; color: var(--amber); margin-bottom: 2px; }
    .alert-body { font-size: 12.5px; color: var(--text); }
    .alert-body a { color: var(--gold); }
    .alert-list { margin-top: 4px; font-size: 12px; color: var(--muted); }

    /* ── Stats ───────────────────────────────────────── */
    .stats {
      display: grid;
      grid-template-columns: 1fr 1fr 2fr;
      gap: 14px;
      margin-bottom: 44px;
    }
    .stat {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px 24px;
    }
    .stat-val {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-size: 42px;
      font-weight: 600;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 4px;
    }
    .stat-lbl {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .14em;
      color: var(--muted);
    }
    .stat-bar {
      display: flex;
      flex-direction: column;
      gap: 14px;
      justify-content: center;
    }
    .bar-head { display: flex; justify-content: space-between; }
    .bar-track {
      height: 5px;
      background: rgba(255,255,255,.05);
      border-radius: 100px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--gold-d), var(--gold));
      border-radius: 100px;
      transition: width .9s var(--ease);
    }

    /* ── Registry card ──────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 20px;
    }
    .card-hdr {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
    }
    .card-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 600;
    }
    .card-tag {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--muted);
    }

    /* ── Table ───────────────────────────────────────── */
    .t-head {
      display: grid;
      grid-template-columns: 3fr 2fr 110px auto;
      padding: 9px 24px;
      border-bottom: 1px solid var(--border);
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: .16em;
      color: var(--muted);
      font-weight: 500;
    }
    .sh-row {
      display: grid;
      grid-template-columns: 3fr 2fr 110px auto;
      align-items: center;
      gap: 10px;
      padding: 14px 24px;
      border-bottom: 1px solid var(--border);
      transition: background .2s var(--ease);
    }
    .sh-row:last-child { border-bottom: none; }
    .sh-row:hover { background: rgba(201,169,110,.025); }
    .sh-name { font-size: 13.5px; font-weight: 500; }
    .sh-jurisdiction { font-size: 13px; color: var(--muted); }
    .sh-pct { font-size: 13px; font-variant-numeric: tabular-nums; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 11px;
      border-radius: 7px;
      font-family: 'DM Sans', sans-serif;
      font-size: 11.5px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: all .22s var(--ease);
    }
    .btn-cert {
      background: rgba(15,37,55,.9);
      color: var(--gold-l);
      border: 1px solid rgba(201,169,110,.18);
    }
    .btn-cert:hover { background: rgba(201,169,110,.1); }

    /* ── Page footer ─────────────────────────────────── */
    .page-ftr {
      padding-top: 28px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: var(--muted);
    }

    /* ── Responsive ──────────────────────────────────── */
    @media (max-width: 768px) {
      body { padding: 28px 16px 60px; }
      .hdr { flex-direction: column; gap: 16px; }
      .hdr h1 { font-size: 38px; }
      .hdr-right { text-align: left; }
      .stats { grid-template-columns: 1fr 1fr; }
      .stat-bar { grid-column: 1 / -1; }
      .t-head { display: none; }
      .sh-row { grid-template-columns: 1fr; }
      .page-ftr { flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>
</head>
<body>
<div class="wrap">

  <!-- Header -->
  <header class="hdr">
    <div>
      <span class="eyebrow">Delaware Corporation · Est. 2026</span>
      <h1>Blue Meridian Fisheries</h1>
      <p class="hdr-sub">{t('idx.subtitle')} · File No. DE 10677862</p>
    </div>
    <div class="hdr-right">
      <div class="hdr-date">{today}</div>
      <div class="status-pill"><span class="dot"></span> {t('idx.statusActive')}</div>
    </div>
  </header>

  <TopNav active="/" />

  <!-- Signing alert -->
  {myPendingRequests.length > 0 && (
    <div class="alert">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <div class="alert-title">
          {t('idx.alertTitle', { n: myPendingRequests.length, s: myPendingRequests.length === 1 ? '' : 's' })}
        </div>
        <div class="alert-body" set:html={t('idx.alertBody', { signLink: `<a href="/sign">${t('nav.sign')}</a>` })} />

        <div class="alert-list">{myPendingRequests.map(r => r.title).join(' · ')}</div>
      </div>
    </div>
  )}

  <!-- Stats -->
  <div class="stats">
    <div class="stat">
      <span class="stat-val">{shareholders.length}</span>
      <span class="stat-lbl">{t('idx.statEntities')}</span>
    </div>
    <div class="stat">
      <span class="stat-val">{totalPct.toFixed(1)}%</span>
      <span class="stat-lbl">{t('idx.statEquity')}</span>
    </div>
    <div class="stat stat-bar">
      <div class="bar-head">
        <span class="stat-lbl">{t('idx.statDistribution')}</span>
        <span class="stat-lbl">{totalPct.toFixed(1)} / 100%</span>
      </div>
      <div class="bar-track">
        <div class="bar-fill" style={`width:${Math.min(totalPct,100)}%`}></div>
      </div>
    </div>
  </div>

  <!-- Registry card (read-only) -->
  <div class="card">
    <div class="card-hdr">
      <span class="card-title">{t('idx.cardTitle')}</span>
      <span class="card-tag">{t('idx.cardTag')}</span>
    </div>

    <div class="t-head">
      <div>{t('idx.colEntity')}</div>
      <div>{t('idx.colJurisdiction')}</div>
      <div>{t('idx.colEquity')}</div>
      <div>{t('idx.colActions')}</div>
    </div>

    {shareholders.map((sh) => (
      <div class="sh-row">
        <div class="sh-name">{sh.name}</div>
        <div class="sh-jurisdiction">{sh.jurisdiction}</div>
        <div class="sh-pct">{sh.percentage.toFixed(2)}%</div>
        <div>
          <a href={`/api/certificate/${sh.id}`} target="_blank" class="btn btn-cert">{t('idx.btnCertificate')}</a>
        </div>
      </div>
    ))}
  </div>

  <!-- Page footer -->
  <footer class="page-ftr">
    <span>Blue Meridian Fisheries Corporation · Delaware · DE 10677862</span>
    <span>{t('idx.footerConfidential')}</span>
  </footer>

</div>
</body>
</html>
