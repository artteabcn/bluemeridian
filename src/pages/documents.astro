---
import TopNav from '../components/TopNav.astro';
import { ensureCompanyDocumentsTable } from '../lib/company-documents-table';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const db = Astro.locals.runtime.env.DB;

await ensureCompanyDocumentsTable(db);

const { results: documents } = await db.prepare('SELECT * FROM company_documents ORDER BY uploaded_at DESC').all() as {
  results: Array<{ id: number; title: string; doc_type: string; file_name: string; file_size: number; uploaded_at: string }>;
};

const today = new Date().toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

function formatSize(bytes: number | null | undefined): string {
  if (!bytes) return '';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1048576) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / 1048576).toFixed(1)} MB`;
}

function formatDate(iso: string): string {
  try { return new Date(iso).toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  catch { return iso; }
}

const DOC_TYPES = [
  { value: 'Bylaws', key: 'doc.typeBylaws' },
  { value: 'Certificate of Incorporation', key: 'doc.typeIncorporation' },
  { value: 'Operating Agreement', key: 'doc.typeOperating' },
  { value: 'Board Resolution', key: 'doc.typeBoardResolution' },
  { value: 'EIN Letter', key: 'doc.typeEin' },
  { value: 'Stock Ledger', key: 'doc.typeStockLedger' },
  { value: 'Other', key: 'doc.typeOther' },
];
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Blue Meridian Fisheries — Official Documents</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #060d14;
      --surface:  #0b1928;
      --border:   rgba(201,169,110,.14);
      --border2:  rgba(255,255,255,.06);
      --gold:     #c9a96e;
      --gold-d:   #8a6d3b;
      --gold-l:   #e8d5a3;
      --text:     #f0ede8;
      --muted:    #4a6580;
      --muted2:   #2d4560;
      --green:    #3dd68c;
      --red:      #f86b6b;
      --ease:     cubic-bezier(.32,.72,0,1);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      padding: 52px 28px 80px;
    }

    .wrap { max-width: 1080px; margin: 0 auto; }

    .hdr {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 36px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 44px;
    }
    .eyebrow {
      display: inline-block;
      font-size: 9.5px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid rgba(201,169,110,.3);
      border-radius: 100px;
      padding: 3px 10px;
      margin-bottom: 14px;
      font-weight: 500;
    }
    .hdr h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 52px;
      font-weight: 600;
      letter-spacing: -.02em;
      line-height: 1;
      color: var(--text);
    }
    .hdr-sub { font-size: 12px; color: var(--muted); margin-top: 10px; letter-spacing: .02em; }
    .hdr-right { text-align: right; }
    .hdr-date { font-size: 11.5px; color: var(--muted); margin-bottom: 8px; }
    .back-link {
      font-size: 11.5px;
      color: var(--gold);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .back-link:hover { text-decoration: underline; }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 32px;
    }
    .card-hdr {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
    }
    .card-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 600;
    }
    .card-tag {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--muted);
    }

    .docs-list { display: flex; flex-direction: column; padding: 8px 0; }
    .docs-empty { font-size: 13px; color: var(--muted); font-style: italic; padding: 24px; text-align: center; }

    .doc-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 24px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .doc-item:last-child { border-bottom: none; }
    .doc-badge {
      font-size: 9.5px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--gold);
      background: rgba(201,169,110,.1);
      border: 1px solid rgba(201,169,110,.22);
      border-radius: 4px;
      padding: 3px 7px;
      white-space: nowrap;
    }
    .doc-title { font-weight: 500; color: var(--text); }
    .doc-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; }
    .doc-meta { color: var(--muted); font-size: 10.5px; white-space: nowrap; }
    .doc-dl {
      color: var(--gold);
      font-size: 11.5px;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
    }
    .doc-dl:hover { text-decoration: underline; }
    .doc-del {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--muted2);
      font-size: 16px;
      line-height: 1;
      padding: 0 2px;
      transition: color .18s;
    }
    .doc-del:hover { color: var(--red); }

    .upload-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 18px 24px;
      border-top: 1px solid var(--border);
      background: rgba(201,169,110,.02);
      flex-wrap: wrap;
    }
    .upload-row input[type="text"] {
      min-width: 200px;
      flex: 1;
      background: rgba(6,13,20,.7);
      border: 1px solid rgba(201,169,110,.14);
      border-radius: 7px;
      padding: 8px 10px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12.5px;
      color: var(--text);
      outline: none;
    }
    .upload-row input[type="text"]:focus {
      border-color: rgba(201,169,110,.5);
      box-shadow: 0 0 0 3px rgba(201,169,110,.07);
    }
    .upload-row input[type="file"] {
      flex: 1;
      min-width: 180px;
      font-size: 12px;
      color: var(--text);
      background: rgba(6,13,20,.7);
      border: 1px solid rgba(201,169,110,.14);
      border-radius: 7px;
      padding: 6px 8px;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
    }
    .upload-row select {
      font-size: 12px;
      color: var(--text);
      background: rgba(6,13,20,.9);
      border: 1px solid rgba(201,169,110,.14);
      border-radius: 7px;
      padding: 8px 10px;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      outline: none;
    }
    .btn-upload {
      background: rgba(201,169,110,.14);
      color: var(--gold);
      border: 1px solid rgba(201,169,110,.28);
      border-radius: 7px;
      padding: 8px 16px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      white-space: nowrap;
      transition: background .2s;
    }
    .btn-upload:hover { background: rgba(201,169,110,.24); }

    .page-ftr {
      padding-top: 28px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      body { padding: 28px 16px 60px; }
      .hdr { flex-direction: column; gap: 16px; }
      .hdr h1 { font-size: 38px; }
      .hdr-right { text-align: left; }
      .doc-item { flex-wrap: wrap; }
      .page-ftr { flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>
</head>
<body>
<div class="wrap">

  <header class="hdr">
    <div>
      <span class="eyebrow">Delaware Corporation · Est. 2026</span>
      <h1>Official Documents</h1>
      <p class="hdr-sub">{t('doc.subtitle')} · File No. DE 10677862</p>
    </div>
    <div class="hdr-right">
      <div class="hdr-date">{today}</div>
    </div>
  </header>

  <TopNav active="/documents" />

  <div class="card">
    <div class="card-hdr">
      <span class="card-title">{t('doc.cardTitle')}</span>
      <span class="card-tag">{documents.length} {documents.length === 1 ? t('doc.files') : t('doc.filesPlural')}</span>
    </div>

    <div class="docs-list">
      {documents.length === 0
        ? <p class="docs-empty">{t('doc.empty')}</p>
        : documents.map(doc => (
            <div class="doc-item">
              <span class="doc-badge">{doc.doc_type}</span>
              <span class="doc-title">{doc.title}</span>
              <span class="doc-name" title={doc.file_name}>{doc.file_name}</span>
              <span class="doc-meta">{formatSize(doc.file_size)}</span>
              <span class="doc-meta">{formatDate(doc.uploaded_at)}</span>
              <a href={`/api/company-documents/${doc.id}`} class="doc-dl">{t('doc.download')}</a>
              <form method="POST" action={`/api/company-documents/${doc.id}`} style="display:inline">
                <input type="hidden" name="action" value="delete" />
                <button
                  type="submit"
                  class="doc-del"
                  title={t('doc.delete')}
                  onclick={`return confirm(${JSON.stringify(t('doc.confirmDelete'))})`}
                >×</button>
              </form>
            </div>
          ))
      }
    </div>

    <form
      method="POST"
      action="/api/company-documents"
      enctype="multipart/form-data"
      class="upload-row"
    >
      <input type="text" name="title" placeholder={t('doc.phTitle')} required />
      <select name="docType">
        {DOC_TYPES.map(dt => <option value={dt.value}>{t(dt.key)}</option>)}
      </select>
      <input type="file" name="file" required />
      <button type="submit" class="btn-upload">{t('doc.btnUpload')}</button>
    </form>
  </div>

  <footer class="page-ftr">
    <span>Blue Meridian Fisheries Corporation · Delaware · DE 10677862</span>
    <span>{t('doc.footerConfidential')}</span>
  </footer>

</div>
</body>
</html>
