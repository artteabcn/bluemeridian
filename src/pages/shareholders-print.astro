---
import { stampBase64 } from '../assets/stamp';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const db = Astro.locals.runtime.env.DB;

const { results: shareholders } = await db.prepare('SELECT * FROM shareholders ORDER BY id').all() as {
  results: Array<{ id: number; name: string; jurisdiction: string; percentage: number }>;
};

const totalPct = shareholders.reduce((s, sh) => s + sh.percentage, 0);
const today = new Date().toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t('print.subtitle')}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:    #0f2537;
      --muted:  #5a6b78;
      --gold:   #8a6d3b;
      --line:   #cfd6db;
      --line2:  #e6e9eb;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      color: var(--ink);
      background: #f4f5f6;
      padding: 40px 24px;
    }

    .sheet {
      max-width: 780px;
      margin: 0 auto;
      background: #fff;
      padding: 56px 60px;
      box-shadow: 0 4px 24px rgba(0,0,0,.08);
    }

    .toolbar {
      max-width: 780px;
      margin: 0 auto 16px;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
    .btn {
      font-family: 'DM Sans', sans-serif;
      font-size: 12.5px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 7px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      text-decoration: none;
    }
    .btn-primary { background: var(--ink); color: #fff; border-color: var(--ink); }

    .hdr {
      text-align: center;
      padding-bottom: 22px;
      border-bottom: 2px solid var(--ink);
      margin-bottom: 28px;
    }
    .eyebrow {
      font-size: 10px;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 8px;
    }
    .hdr h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 34px;
      font-weight: 600;
    }
    .hdr-sub { font-size: 11.5px; color: var(--muted); margin-top: 6px; }

    .meta-row {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 24px;
    }

    table { width: 100%; border-collapse: collapse; }
    thead th {
      text-align: left;
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--muted);
      padding: 0 0 10px;
      border-bottom: 1.5px solid var(--ink);
    }
    thead th.num { text-align: right; }
    tbody td {
      padding: 12px 0;
      border-bottom: 1px solid var(--line2);
      font-size: 13.5px;
      vertical-align: top;
    }
    tbody td.num { text-align: right; font-variant-numeric: tabular-nums; }
    tbody tr:last-child td { border-bottom: 1px solid var(--ink); }
    .idx { color: var(--muted); font-size: 11px; padding-right: 10px; }

    tfoot td {
      padding: 14px 0 0;
      font-weight: 600;
      font-size: 13.5px;
    }
    tfoot td.num { text-align: right; font-variant-numeric: tabular-nums; }

    .sign-block {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 72px;
    }
    .sign {
      width: 220px;
    }
    .sign-line { border-top: 1px solid var(--ink); margin-bottom: 6px; }
    .sign-lbl { font-size: 10.5px; color: var(--muted); }

    .stamp {
      width: 108px;
      height: 108px;
      object-fit: contain;
      opacity: .92;
    }

    .ftr {
      margin-top: 40px;
      padding-top: 16px;
      border-top: 1px solid var(--line2);
      font-size: 10px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
    }

    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none; }
      .sheet { box-shadow: none; padding: 0; max-width: none; }
      @page { margin: 22mm 18mm; }
    }
  </style>
</head>
<body>

  <div class="toolbar">
    <a href="/" class="btn">&larr; {t('print.back')}</a>
    <button class="btn btn-primary" onclick="window.print()">{t('print.printBtn')}</button>
  </div>

  <div class="sheet">
    <div class="hdr">
      <div class="eyebrow">Delaware Corporation · Est. 2026</div>
      <h1>Blue Meridian Fisheries Corporation</h1>
      <div class="hdr-sub">{t('print.subtitle')} · File No. DE 10677862</div>
    </div>

    <div class="meta-row">
      <span>{t('print.asOf', { date: today })}</span>
      <span>{shareholders.length} {shareholders.length === 1 ? t('print.record') : t('print.recordPlural')}</span>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width:32px;">{t('print.colNum')}</th>
          <th>{t('print.colEntity')}</th>
          <th>{t('print.colJurisdiction')}</th>
          <th class="num">{t('print.colEquity')}</th>
        </tr>
      </thead>
      <tbody>
        {shareholders.map((sh, i) => (
          <tr>
            <td class="idx">{i + 1}</td>
            <td>{sh.name}</td>
            <td>{sh.jurisdiction}</td>
            <td class="num">{sh.percentage.toFixed(2)}%</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td>{t('print.total')}</td>
          <td class="num">{totalPct.toFixed(2)}%</td>
        </tr>
      </tfoot>
    </table>

    <div class="sign-block">
      <div class="sign">
        <div class="sign-line"></div>
        <div class="sign-lbl">{t('print.signDirector')}</div>
      </div>
      <img class="stamp" src={`data:image/png;base64,${stampBase64}`} alt="Corporate Seal" />
      <div class="sign">
        <div class="sign-line"></div>
        <div class="sign-lbl">{t('print.signDate')}</div>
      </div>
    </div>

    <div class="ftr">
      <span>Blue Meridian Fisheries Corporation · Delaware · DE 10677862</span>
      <span>{t('print.footerConfidential')}</span>
    </div>
  </div>

</body>
</html>
