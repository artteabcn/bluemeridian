---
import TopNav from '../../../components/TopNav.astro';

const db = Astro.locals.runtime.env.DB;
const { id } = Astro.params;

const { results } = await db.prepare('SELECT * FROM signature_requests WHERE id = ?').bind(Number(id)).all();
const req = results[0] as { id: number; title: string; status: string; embedded_edit_url: string | null } | undefined;

if (!req) return Astro.redirect('/sign?error=' + encodeURIComponent('Signature request not found'));
if (req.status !== 'draft' || !req.embedded_edit_url) return Astro.redirect('/sign');

const redirectUrl = new URL(`/api/signature-requests/${req.id}/mark-sent`, Astro.url.origin).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Place Signature Fields</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #060d14; --surface: #0b1928;
      --border: rgba(201,169,110,.14); --gold: #c9a96e; --gold-l: #e8d5a3;
      --text: #f0ede8; --muted: #4a6580; --red: #f86b6b;
      --ease: cubic-bezier(.32,.72,0,1);
    }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100dvh; padding: 32px 28px 40px; }
    .wrap { max-width: 1080px; margin: 0 auto; }
    .hdr { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .hdr h1 { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 600; }
    .hdr-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .back-link { font-size: 12px; color: var(--gold); text-decoration: none; }
    .back-link:hover { text-decoration: underline; }

    .hint { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px; font-size: 12.5px; color: var(--muted); margin-bottom: 18px; }
    .hint b { color: var(--text); }

    .editor-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; height: 78vh; display: flex; align-items: center; justify-content: center; }
    #signwell-editor { width: 100%; height: 100%; }
    .loading { font-size: 13px; color: var(--muted); }
    .error-msg { color: var(--red); font-size: 13px; padding: 24px; text-align: center; }
  </style>
</head>
<body>
<div class="wrap">
  <header class="hdr">
    <div>
      <h1>Place Signature Fields</h1>
      <p class="hdr-sub">{req.title}</p>
    </div>
    <a href="/sign" class="back-link">&larr; Back to Sign Documents (draft stays saved)</a>
  </header>

  <div class="hint">
    Drag a <b>signature field</b> onto each shareholder's spot on the actual document below, on whichever page
    makes sense — then click <b>Send</b> inside the editor. If you close this without sending, the draft stays
    on the Sign Documents list; you can delete it and start over if the editor link has expired.
  </div>

  <div class="editor-wrap">
    <div id="signwell-editor"><p class="loading">Loading editor…</p></div>
  </div>
</div>

<script src="https://static.signwell.com/assets/embedded.js"></script>
<script define:vars={{ embedUrl: req.embedded_edit_url, redirectUrl }}>
  try {
    const embed = new SignWellEmbed({
      url: embedUrl,
      containerId: 'signwell-editor',
      requestingRedirectUrl: redirectUrl,
      events: {
        error: (e) => {
          document.getElementById('signwell-editor').innerHTML =
            '<p class="error-msg">Could not load the SignWell editor (the link may have expired). Go back and delete this draft, then start again.</p>';
          console.error('SignWell embed error', e);
        },
      },
    });
    embed.open();
  } catch (e) {
    document.getElementById('signwell-editor').innerHTML =
      '<p class="error-msg">Could not start the SignWell editor.</p>';
    console.error(e);
  }
</script>
</body>
</html>
